# Required backend configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=TravelOS
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-development-password

# Runtime and web configuration
ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# AI and optional enrichment
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_IDS=
UNSPLASH_ACCESS_KEY=
WIKIPEDIA_USER_AGENT=TravelOS/1.0 (contact: your-project-contact)
OPENWEATHER_API_KEY=

# Required for production password-reset email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESET_EMAIL_FROM=
